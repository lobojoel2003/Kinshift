# Copy to .env and adjust. Every setting is optional except where noted.

# Encrypts health data at rest (AES-256-GCM). At least 32 characters.
# Generate one with: openssl rand -hex 32
# Store a copy separately from your backups: without it, encrypted data is unreadable.
# If unset, Kinshift generates one in $DATA_DIR/kinshift.secret on first start.
KINSHIFT_SECRET=

# Only needed while rotating the secret: put the old value here, the new value in
# KINSHIFT_SECRET, start Kinshift once, then remove this line.
KINSHIFT_PREVIOUS_SECRET=

# Public URL used in invite links, e.g. https://care.example.com
KINSHIFT_URL=

# "invite" (default): after the first account, sign-up requires an invite link.
# "open": anyone who can reach the server can create an account.
KINSHIFT_REGISTRATION=invite

# Where the SQLite database and generated secret live. Defaults to ./data
DATA_DIR=./data

# Web push. Kinshift generates VAPID keys automatically; set these only to use your own.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@example.com or an https:// URL
VAPID_SUBJECT=

# Port for `docker compose` (host side)
KINSHIFT_PORT=3000

# Locale for dates and times on the server, e.g. en-GB
KINSHIFT_LOCALE=en-US
